{
  "expo": {
    "name": "HiBank",
    "slug": "hibank",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "hibank",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hibank.bws",
      "infoPlist": {
        "NSFaceIDUsageDescription": "HiBank membutuhkan Face ID untuk autentikasi dan otorisasi transaksi yang aman."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A2540",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.hibank.bws",
      "predictiveBackGestureEnabled": false,
      "permissions": ["USE_BIOMETRIC", "USE_FINGERPRINT"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "HiBank membutuhkan Face ID untuk autentikasi dan otorisasi transaksi yang aman."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
